// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  canManageUsers Boolean @default(false)
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  role      String // apenas "admin"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  artigos         Artigo[]
  acervos         Acervo[]
  videosEspeciais VideoEspecial[]
}

model AdminSession {
  tokenHash String @id @db.VarChar(64)
  usuarioId Int
  expiresAt DateTime
  @@index([usuarioId])
  @@index([expiresAt])
}

model AdminInvite {
  id Int @id @default(autoincrement())
  email String
  tokenHash String @unique @db.VarChar(64)
  canManageUsers Boolean @default(false)
  recovery Boolean @default(false)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}

model AuditEvent {
  id Int @id @default(autoincrement())
  usuarioId Int?
  action String
  createdAt DateTime @default(now())
}

model RateBucket {
  id String @id @db.VarChar(64)
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model ContentTranslation {
  id Int @id @default(autoincrement())
  entity String @db.VarChar(40)
  entityId Int
  field String @db.VarChar(40)
  locale String @db.VarChar(5)
  sourceHash String @db.VarChar(64)
  source String @db.LongText
  text String @db.LongText
  status String @default("draft") @db.VarChar(20)
  updatedAt DateTime @updatedAt
  @@unique([entity, entityId, field, locale])
}

model ProtectedTerm {
  id Int @id @default(autoincrement())
  term String @unique
}

model VisitorDay {
  day String @id @db.VarChar(10)
  count Int @default(0)
}

model VisitorReceipt {
  id String @id @db.VarChar(64)
  day String @db.VarChar(10)
  @@index([day])
}

model Artigo {
  id             Int       @id @default(autoincrement())
  titulo         String
  resumo         String?   @db.Text
  conteudo       String    @db.LongText
  imagem         String? // URL da imagem principal
  video          String? // URL do vídeo (opcional)
  dataPublicacao DateTime?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  usuarioId      Int
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
}

model Acervo {
  id                Int      @id @default(autoincrement())
  titulo            String
  descricao         String?  @db.Text
  imagem            String?
  ordem             Int?
  colecao           String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  usuarioId         Int
  nome              String?
  numeroInventario  String?
  artista           String?
  tags              String?
  localizacao       String?
  periodo           String?
  dataProducao      String?
  material          String?
  tecnica           String?
  altura            String?
  largura           String?
  profundidade      String?
  cidadeOrigem      String?
  estadoOrigem      String?
  paisOrigem        String?
  contextoHistorico String?  @db.Text
  doador            String?
  formaAquisicao    String?
  estadoConservacao String?
  imagemCapa        String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  midias AcervoMidia[]
}

model AcervoMidia {
  id        Int      @id @default(autoincrement())
  acervoId  Int
  tipo      String // "imagem" ou "iframe"
  url       String   @db.Text
  titulo    String? // Título/descrição da mídia
  ordem     Int? // Ordem no carrossel
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relacionamento
  acervo Acervo @relation(fields: [acervoId], references: [id], onDelete: Cascade)
}

model VideoEspecial {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String?  @db.Text
  tipo      String // "intro", "banner", "capa"
  video     String // URL do vídeo
  thumbnail String? // URL da thumbnail
  ordem     Int?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model ContadorVisitante {
  id           Int      @id @default(autoincrement())
  contador     Int
  dataRegistro DateTime
  ipOrigem     String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model Configuracao {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String   @db.Text
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
